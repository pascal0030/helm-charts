{
  "$schema": "http://json-schema.org/schema#",
  "title": "infinidysk Helm Chart Values",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": { "type": "string" },
        "imagePullSecrets": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": { "type": "object" },
    "commonAnnotations": { "type": "object" },
    "image": {
      "type": "object",
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "imagePullPolicy": { "type": "string" }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "saEnabled": { "type": "boolean" },
        "createSecret": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "apiKey": { "type": "string" },
        "sessionKey": { "type": "string" },
        "sabApiKey": { "type": "string" },
        "webdavUser": { "type": "string" },
        "webdavPassword": { "type": "string" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "timezone": { "type": "string" },
        "puid": { "type": "integer" },
        "pgid": { "type": "integer" },
        "logLevel": { "type": "string" },
        "database": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string" }
          }
        },
        "settings": { "type": "object" },
        "secretSettings": { "type": "object" },
        "useExternalSecret": { "type": "boolean" },
        "externalSecret": {
          "type": "object",
          "properties": {
            "refreshInterval": { "type": "string" },
            "secretStoreRef": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "kind": { "type": "string" }
              }
            },
            "data": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "secretKey": { "type": "string" },
                  "key": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "mount": {
      "type": "object",
      "properties": {
        "fuse": { "type": "boolean" },
        "dir": { "type": "string" },
        "devFusePath": { "type": "string" },
        "bdi": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "path": { "type": "string" }
          }
        },
        "hostPath": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "path": { "type": "string" },
            "mountPath": { "type": "string" },
            "mountPropagation": {
              "type": "string",
              "enum": ["None", "HostToContainer", "Bidirectional"]
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer" },
        "nodePort": { "type": "string" },
        "clusterIP": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "size": { "type": "string" },
        "annotations": { "type": "object" },
        "selector": { "type": "object" }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "fsGroup": { "type": "integer" },
        "fsGroupChangePolicy": { "type": "string" }
      }
    },
    "containerSecurityContext": {
      "type": "object",
      "properties": {
        "runAsUser": { "type": "integer" },
        "runAsGroup": { "type": "integer" },
        "runAsNonRoot": { "type": "boolean" },
        "allowPrivilegeEscalation": { "type": "boolean" },
        "privileged": { "type": "boolean" },
        "capabilities": {
          "type": "object",
          "properties": {
            "add": {
              "type": "array",
              "items": { "type": "string" }
            },
            "drop": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "appArmorProfile": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "localhostProfile": { "type": "string" }
          }
        }
      }
    },
    "resources": { "type": "object" },
    "env": {
      "type": "array",
      "items": { "type": "object" }
    },
    "extraSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "secretName": { "type": "string" },
          "key": { "type": "string" },
          "path": { "type": "string" },
          "mountPath": { "type": "string" },
          "subPath": { "type": "string" }
        }
      }
    },
    "extraConfigMaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "configMapName": { "type": "string" },
          "mountPath": { "type": "string" },
          "subPath": { "type": "string" }
        }
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "mountPath": { "type": "string" },
          "pvcName": { "type": "string" }
        }
      }
    },
    "nfsVolumes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "mountPath": { "type": "string" },
          "nfs": {
            "type": "object",
            "properties": {
              "server": { "type": "string" },
              "path": { "type": "string" }
            }
          }
        }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer" },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "initialDelaySeconds": { "type": "integer" },
        "periodSeconds": { "type": "integer" },
        "timeoutSeconds": { "type": "integer" },
        "failureThreshold": { "type": "integer" },
        "successThreshold": { "type": "integer" }
      }
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "initialDelaySeconds": { "type": "integer" },
        "periodSeconds": { "type": "integer" },
        "timeoutSeconds": { "type": "integer" },
        "failureThreshold": { "type": "integer" },
        "successThreshold": { "type": "integer" }
      }
    },
    "startupProbe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "initialDelaySeconds": { "type": "integer" },
        "periodSeconds": { "type": "integer" },
        "timeoutSeconds": { "type": "integer" },
        "failureThreshold": { "type": "integer" },
        "successThreshold": { "type": "integer" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hosts": {
                "type": "array",
                "items": { "type": "string" }
              },
              "secretName": { "type": "string" }
            }
          }
        }
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "main": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "hostnames": {
              "type": "array",
              "items": { "type": "string" }
            },
            "parentRefs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "group": { "type": "string" },
                  "kind": { "type": "string" },
                  "namespace": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowExternal": { "type": "boolean" },
        "allowExternalEgress": { "type": "boolean" },
        "ingressNSMatchLabels": { "type": "object" },
        "ingressNSPodMatchLabels": { "type": "object" },
        "extraIngress": {
          "type": "array",
          "items": { "type": "object" }
        },
        "extraEgress": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string" },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" },
            "path": { "type": "string" },
            "bearerTokenSecret": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "key": { "type": "string" }
              }
            },
            "relabelings": {
              "type": "array",
              "items": { "type": "object" }
            },
            "metricRelabelings": {
              "type": "array",
              "items": { "type": "object" }
            },
            "honorLabels": { "type": "boolean" },
            "selector": { "type": "object" },
            "annotations": { "type": "object" },
            "namespaceSelector": { "type": "object" }
          }
        }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "affinity": { "type": "object" },
    "initContainers": {
      "type": "array",
      "items": { "type": "object" }
    },
    "extraObjects": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
